---
// לייאאוט מנהל: פשוט, ללא ClientRouter, לא מאונדקס.
import '@fontsource/heebo/400.css';
import '@fontsource/heebo/700.css';
import '@fontsource/frank-ruhl-libre/400.css';
import '../styles/base.css';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · ניהול am-i.ai</title>
    <style is:global>
      .admin { max-width: 860px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
      .admin-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; border-bottom: 1px solid var(--rule); padding-bottom: 0.75rem; margin-bottom: 1.5rem; }
      .admin-head h1 { font-size: 1.25rem; }
      .admin-nav { display: flex; gap: 1rem; font-size: 0.9rem; }
      .admin-nav a, .admin-nav button { color: var(--muted); text-decoration: none; }
      .admin-nav a:hover, .admin-nav button:hover { color: var(--fg); }
      .admin h2 { font-size: 1rem; margin: 2rem 0 0.75rem; color: var(--muted); }
      .admin label { display: grid; gap: 0.3rem; font-size: 0.85rem; color: var(--muted); }
      .admin label.row { display: flex; align-items: center; gap: 0.5rem; color: var(--fg); }
      .admin input, .admin textarea, .admin select { font: inherit; font-size: 1rem; color: var(--fg); background: var(--bg); border: 1px solid var(--rule); border-radius: 4px; padding: 0.5rem 0.65rem; width: 100%; }
      .admin textarea[name='body'] { font-family: var(--font-serif); font-size: 1.1rem; line-height: 1.6; min-height: 24rem; }
      .admin input:focus, .admin textarea:focus, .admin select:focus { outline: none; border-color: var(--fg); }
      .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
      .grid3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.9rem; }
      @media (max-width: 640px) { .grid2, .grid3 { grid-template-columns: 1fr; } }
      .btn { font-size: 0.9rem; padding: 0.5rem 1rem; border-radius: 999px; background: var(--fg); color: var(--bg); }
      .btn.secondary { background: var(--faint); color: var(--fg); }
      .btn.danger { background: #b3261e; color: #fff; }
      .btn.small { font-size: 0.8rem; padding: 0.3rem 0.75rem; }
      .row { display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }
      .status { font-size: 0.85rem; color: var(--muted); min-height: 1.2em; }
      .status.err { color: #b3261e; }
      .list { list-style: none; margin: 0; padding: 0; }
      .list li { padding: 0.9rem 0; border-bottom: 1px solid var(--rule); display: grid; gap: 0.4rem; }
      .list .body { font-family: var(--font-serif); font-size: 1.05rem; white-space: pre-wrap; }
      .list .meta { font-size: 0.8rem; }
      .tabs { display: flex; gap: 0.5rem; }
      .tabs button { font-size: 0.85rem; padding: 0.3rem 0.8rem; border-radius: 999px; background: var(--faint); color: var(--muted); }
      .tabs button[aria-selected='true'] { background: var(--fg); color: var(--bg); }
      .login { max-width: 360px; margin: 15vh auto; display: grid; gap: 1rem; }
      .notice { background: var(--faint); border-radius: 6px; padding: 0.75rem 1rem; font-size: 0.9rem; color: var(--muted); }
      .posts-list a { text-decoration: none; font-weight: 700; }
      .posts-list a:hover { text-decoration: underline; }
      .post-preview { font-family: var(--font-serif); }
      .toolbar { display: flex; gap: 0.5rem; flex-wrap: wrap; font-size: 0.8rem; }
      .toolbar button { background: var(--faint); border-radius: 4px; padding: 0.25rem 0.6rem; }
    </style>
  </head>
  <body>
    <main class="admin"><slot /></main>
  </body>
</html>
