---
import { Image } from 'astro:assets';
import type { Post } from '../lib/posts';
import PostMeta from './PostMeta.astro';
import { isoDate } from '../lib/dates';
interface Props { post: Post; index?: number }
const { post, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/blog/${post.id}`;
---

<article class="card">
  {typeof index === 'number' && <span class="card-index mono" aria-hidden="true">{String(index).padStart(3, '0')}</span>}
  {post.data.cover && (
    <a class="card-cover" href={href} tabindex="-1" aria-hidden="true">
      <Image src={post.data.cover} alt="" width="640" height="400" loading="lazy" />
    </a>
  )}
  <div class="card-body">
    <PostMeta post={post} compact />
    <h3 class="card-title"><a href={href}>{post.data.title}</a></h3>
    <p class="card-desc">{post.data.description}</p>
    <span class="card-date mono" aria-hidden="true">{isoDate(post.data.date)}</span>
  </div>
</article>
