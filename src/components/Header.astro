---
import { SITE } from '../lib/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
const nav = [
  { href: `${base}/`, label: 'מאמרים', active: path === '/' },
  { href: `${base}/archive`, label: 'ארכיון', active: path.startsWith('/archive') },
  { href: `${base}/rss.xml`, label: 'RSS', active: false },
];
---

<header class="site-header">
  <a class="brand" href={`${base}/`} aria-label={SITE.title}>
    <span class="brand-mark" aria-hidden="true">
      <svg viewBox="0 0 48 24" width="48" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <path d="M12 12c0-4 3-7 6.5-7C24 5 24 19 29.5 19 33 19 36 16 36 12s-3-7-6.5-7C24 5 24 19 18.5 19 15 19 12 16 12 12z" />
      </svg>
    </span>
    <span class="brand-text">
      <span class="brand-title">{SITE.title}</span>
      <span class="brand-tag">{SITE.tagline}</span>
    </span>
  </a>
  <nav class="site-nav" aria-label="ניווט">
    {nav.map((n) => (
      <a href={n.href} aria-current={n.active ? 'page' : undefined}>{n.label}</a>
    ))}
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="החלף בין מצב בהיר לכהה" title="אור / חושך">
      <svg class="ico-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      <svg class="ico-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
    </button>
  </nav>
</header>
