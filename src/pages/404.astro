---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="לא נמצא">
  <section class="page-head notfound">
    <h1>הדף הזה לא נמצא</h1>
    <p class="page-lede">אולי הוא עבר, אולי מעולם לא היה. <a href={`${base}/archive`}>הארכיון</a> יודע מה כן קיים.</p>
  </section>
</Base>
