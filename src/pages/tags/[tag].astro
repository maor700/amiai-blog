---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts, type Post } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await allPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
interface Props { tag: string; posts: Post[] }
const { tag, posts } = Astro.props;
---

<Base title={`#${tag}`} description={`מאמרים בתגית ${tag}`}>
  <section class="list">
    <header class="page-head">
      <p class="mono kicker">› תגית</p>
      <h1>#{tag}</h1>
    </header>
    <div class="cards">{posts.map((p) => <PostCard post={p} />)}</div>
  </section>
</Base>
