# Sanity Configuration
# Get these values from https://sanity.io/manage
SANITY_PROJECT_ID=your_project_id_here
SANITY_DATASET=production
SANITY_ORGANIZATION_ID=your_org_id_here
SANITY_API_VERSION=v2022-03-07

# Sanity API Token
# Create at: https://sanity.io/manage/personal/project/[project-id]/api
# Required permissions: Editor or higher for write access
SANITY_TOKEN=your_sanity_token_here

# Public environment variables (exposed to client)
# These are safe to expose as they're used in client-side code
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production